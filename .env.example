# ─────────────────────────────────────────────────────────────
# Star Studio's — Configuración de entorno
#
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas el archivo .env real a un repositorio público.
# ─────────────────────────────────────────────────────────────

# URL del Webhook de Discord para el canal de tickets.
# Cómo obtenerla: Canal de Discord → Configuración → Integraciones → Webhooks → Crear Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/TU_ID/TU_TOKEN

# Ambiente de Flask (development | production)
FLASK_ENV=development
FLASK_DEBUG=1
